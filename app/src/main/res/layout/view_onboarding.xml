<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <LinearLayout
            android:layout_width="76dp"
            android:layout_height="76dp"
            android:background="@drawable/bg_icon_chip"
            android:gravity="center">

            <ImageView
                android:layout_width="34dp"
                android:layout_height="34dp"
                android:src="@drawable/ic_flame"
                android:tint="@color/accent" />
        </LinearLayout>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:text="blue"
            android:textColor="@color/accent"
            android:textSize="16sp"
            android:textStyle="bold"
            android:letterSpacing="-0.02" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:text="Your gas.\nVerified. Delivered."
            android:textColor="@color/ink"
            android:textSize="24sp"
            android:textStyle="bold"
            android:lineSpacingMultiplier="1.15" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="We pick it up, refill it at a trusted station, weigh it, bring it back."
            android:textColor="@color/muted"
            android:textSize="13.5sp"
            android:lineSpacingMultiplier="1.4" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:orientation="vertical"
            android:background="@drawable/bg_card"
            android:padding="6dp">

            <include layout="@layout/row_feature"
                android:id="@+id/featureVerified" />
            <include layout="@layout/row_feature"
                android:id="@+id/featureWeighed" />
            <include layout="@layout/row_feature"
                android:id="@+id/featureLoaner" />

        </LinearLayout>

        <View
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:layout_marginTop="18dp" />

        <Button
            android:id="@+id/btnGetStarted"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/btn_accent"
            android:text="Get started"
            android:textColor="@color/white"
            android:textAllCaps="false"
            android:textSize="14sp"
            android:paddingTop="14dp"
            android:paddingBottom="14dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:orientation="horizontal"
            android:gravity="center"
            android:clickable="true"
            android:focusable="true"
            android:id="@+id/tvCallOnboarding">

            <ImageView
                android:layout_width="14dp"
                android:layout_height="14dp"
                android:src="@drawable/ic_phone"
                android:tint="@color/accent" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:text="Or call 0803 000 1122"
                android:textColor="@color/accent"
                android:textSize="12.5sp" />
        </LinearLayout>

    </LinearLayout>
</ScrollView>
